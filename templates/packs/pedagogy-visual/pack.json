{
  "schemaVersion": "2.0.0",
  "id": "pedagogy-visual",
  "name": "Sư Phạm Trực Quan & Sinh Động (Pedagogy Visual)",
  "description": "Bộ mẫu bài giảng sư phạm sinh động tối ưu cho nhiều nội dung chữ, thẻ ghi nhớ, sơ đồ vector và hiệu ứng hoạt họa GSAP mượt mà",
  "aspectRatio": "16:9",
  "previewVideoUrl": "renders/preview_pedagogy.mp4",
  "tags": {
    "subject": ["toan-tin", "khoa-hoc-tu-nhien", "tong-hop"],
    "style": ["sinh-dong-tre-trung", "hien-dai-toi-gian"],
    "effect": ["nang-dong-kinetic", "nhe-nhang-fade"]
  },
  "tokens": {
    "colors": {
      "primary": "#4F46E5",
      "primaryHover": "#4338CA",
      "accent": "#059669",
      "bgCanvas": "#F8FAFC",
      "bgCard": "#FFFFFF",
      "textMain": "#0F172A",
      "textSub": "#334155",
      "border": "#CBD5E1"
    },
    "fonts": {
      "heading": "Be Vietnam Pro, sans-serif",
      "body": "Be Vietnam Pro, sans-serif",
      "code": "JetBrains Mono, monospace"
    },
    "spacing": {
      "headerHeight": "88px",
      "footerHeight": "76px",
      "contentHeight": "916px",
      "padScreenX": "72px",
      "padScreenY": "28px",
      "gapCards": "28px"
    }
  },
  "layouts": [
    {
      "id": "title-slide",
      "name": "Tiêu Đề Bài Giảng Trực Quan",
      "purpose": "title",
      "slots": [
        { "id": "badge", "role": "badge", "accepts": ["text"], "optional": true },
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "author", "role": "body", "accepts": ["text"], "optional": true },
        { "id": "media", "role": "media", "accepts": ["image", "video"], "optional": true }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Mặc định (Chữ trái - Ảnh phải)" },
        { "id": "fullscreen", "name": "Toàn màn hình (Fullscreen)" },
        { "id": "stacked-top", "name": "Xếp chồng (Chữ trên - Ảnh dưới)" },
        { "id": "text-left-image-right", "name": "Chữ trái - Ảnh phải" },
        { "id": "text-right-image-left", "name": "Chữ phải - Ảnh trái" },
        { "id": "no-image", "name": "Không Có Ảnh" }
      ],
      "defaultAnimations": [
        { "target": ".title-hero-heading", "preset": "zoom-in", "delay": 0.2, "duration": 0.8, "easing": "back.out" },
        { "target": ".title-hero-sub", "preset": "fade-in", "delay": 0.5, "duration": 0.8, "easing": "power2.out" },
        { "target": ".title-hero-image-wrap", "preset": "slide-in", "delay": 0.6, "duration": 1.0, "easing": "power2.out" }
      ]
    },
    {
      "id": "concept-explain",
      "name": "Giải Thích Khái Niệm Chi Tiết",
      "purpose": "concept-explain",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "concept", "role": "body", "accepts": ["text"] },
        { "id": "media", "role": "media", "accepts": ["image", "video"], "optional": true }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Mặc định (Thẻ trái - Ảnh phải)" },
        { "id": "text-right-image-left", "name": "Ảnh trái - Thẻ phải" },
        { "id": "stacked-top", "name": "Banner trên - Thẻ dưới" },
        { "id": "no-image", "name": "Toàn bộ văn bản (Không có ảnh)" },
        { "id": "fullscreen", "name": "Tràn viền nền ảnh" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".concept-card", "preset": "fade-in", "delay": 0.4, "duration": 1.0, "easing": "power2.out" },
        { "target": ".concept-image-wrap", "preset": "zoom-in", "delay": 0.6, "duration": 0.9, "easing": "back.out" }
      ]
    },
    {
      "id": "bullet-breakdown",
      "name": "Phân Tích Đa Điểm & Ghi Nhớ",
      "purpose": "bullet-breakdown",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "cards", "role": "cards", "accepts": ["list"] }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Lưới thẻ đồng đều" },
        { "id": "no-image", "name": "Toàn màn hình" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".breakdown-card", "preset": "slide-in", "delay": 0.4, "duration": 0.8, "easing": "power2.out" }
      ]
    },
    {
      "id": "image-explain",
      "name": "Sơ Đồ Trực Quan & Vector Toán Học",
      "purpose": "image-explain",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "media", "role": "media", "accepts": ["image", "video"] },
        { "id": "explanation", "role": "body", "accepts": ["text"] }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Ảnh lớn trái - Giải thích phải" },
        { "id": "text-right-image-left", "name": "Giải thích trái - Ảnh lớn phải" },
        { "id": "stacked-top", "name": "Ảnh trên - Thẻ dưới" },
        { "id": "no-image", "name": "Không có ảnh" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".explain-image-wrap", "preset": "zoom-in", "delay": 0.4, "duration": 1.0, "easing": "back.out" },
        { "target": ".explain-text-card", "preset": "fade-in", "delay": 0.7, "duration": 0.8, "easing": "power2.out" }
      ]
    },
    {
      "id": "comparison",
      "name": "So Sánh Đối Chiếu 2 Cột",
      "purpose": "comparison",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "leftCol", "role": "card", "accepts": ["text"] },
        { "id": "rightCol", "role": "card", "accepts": ["text"] }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "2 cột cân xứng" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".comparison-card", "preset": "slide-in", "delay": 0.4, "duration": 0.9, "easing": "power2.out" }
      ]
    },
    {
      "id": "formula-explain",
      "name": "Công Thức & Định Lý Khoa Học",
      "purpose": "formula-explain",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "formula", "role": "body", "accepts": ["text"] },
        { "id": "explanation", "role": "body", "accepts": ["text"], "optional": true }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Công thức nổi bật ở giữa" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".formula-card", "preset": "zoom-in", "delay": 0.4, "duration": 1.0, "easing": "back.out" }
      ]
    },
    {
      "id": "summary",
      "name": "Tổng Kết Bài Học & Ghi Nhớ Trọng Tâm",
      "purpose": "summary",
      "slots": [
        { "id": "title", "role": "title", "accepts": ["text"] },
        { "id": "subtitle", "role": "subtitle", "accepts": ["text"], "optional": true },
        { "id": "bullets", "role": "bullets", "accepts": ["list"] }
      ],
      "decor": [],
      "variants": [
        { "id": "default", "name": "Danh sách thẻ tổng kết" }
      ],
      "defaultAnimations": [
        { "target": ".slide-title", "preset": "slide-in", "delay": 0.2, "duration": 0.8, "easing": "power2.out" },
        { "target": ".summary-bullet-item", "preset": "slide-in", "delay": 0.4, "duration": 0.8, "easing": "power2.out" }
      ]
    }
  ]
}
