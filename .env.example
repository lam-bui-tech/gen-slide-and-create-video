# AI Lecture Studio - Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# Google Gemini API Key (Required for Stage 2: generating tailored outlines from uploaded documents)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Model override (default is gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: VieNeu-TTS Voice Settings
TTS_PROVIDER=vieneu
DEFAULT_VOICE=MyDuyen
