{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonSceneJSON",
  "description": "Unified source of truth defining all slides, slots, media recommendations, animations, and voice-over tracks for HyperFrames engine (v2)",
  "type": "object",
  "required": ["projectId", "title", "slides"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "default": 2,
      "description": "Schema version (1 = legacy templateId/elements, 2 = packId/slotValues)"
    },
    "packId": {
      "type": "string",
      "default": "basic",
      "description": "Selected template pack identifier"
    },
    "projectId": {
      "type": "string",
      "description": "Unique identifier of the lecture project"
    },
    "title": {
      "type": "string",
      "description": "Lecture title"
    },
    "theme": {
      "type": "object",
      "properties": {
        "colorScheme": { "type": "string", "default": "academic-ocean" },
        "fontFamily": { "type": "string", "default": "Be Vietnam Pro, sans-serif" },
        "aspectRatio": { "type": "string", "default": "16:9" }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SlideScene"
      },
      "minItems": 1,
      "description": "Array of timed slides composing the presentation"
    },
    "totalDurationSeconds": {
      "type": "number",
      "description": "Calculated total duration across all slides"
    }
  },
  "definitions": {
    "SlideScene": {
      "type": "object",
      "required": [
        "slideId",
        "voice",
        "durationSeconds"
      ],
      "properties": {
        "slideId": {
          "type": "string",
          "description": "Unique slide identifier (e.g. slide-01)"
        },
        "layoutId": {
          "type": "string",
          "description": "Layout identifier from the chosen Template Pack"
        },
        "templateId": {
          "type": "string",
          "description": "Legacy template identifier (v1 backward compatibility)"
        },
        "variantId": {
          "type": "string",
          "default": "default",
          "description": "Visual layout variant id"
        },
        "layoutVariant": {
          "type": "string",
          "description": "Legacy layout variant alias (v1 compatibility)"
        },
        "title": {
          "type": "string",
          "description": "Slide header or key assertion"
        },
        "subtitle": {
          "type": "string",
          "description": "Optional secondary tagline or chapter tag"
        },
        "slotValues": {
          "type": "object",
          "description": "Slot values mapped by slot id matching the layout definition"
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MediaCandidate"
          },
          "default": [],
          "description": "Selected or recommended media items for this slide"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideElement"
          },
          "default": [],
          "description": "Custom or decor semantic elements belonging to this slide"
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimationItem"
          },
          "default": [],
          "description": "GSAP animation cues synchronized with speech"
        },
        "voice": {
          "$ref": "#/definitions/VoiceConfig",
          "description": "Voice-over track configuration and audio synthesis metadata"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 1.0,
          "description": "Slide duration in seconds. Audio-first sync: driven by real TTS audio duration"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes or pedagogical teaching instructions"
        }
      }
    },
    "MediaCandidate": {
      "type": "object",
      "required": ["id", "source", "type", "url"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this media candidate"
        },
        "source": {
          "type": "string",
          "enum": ["document", "diagram", "chart", "upload", "ai-image"],
          "description": "Origin of the media candidate"
        },
        "type": {
          "type": "string",
          "enum": ["image", "video", "diagram"],
          "description": "Type of media"
        },
        "url": {
          "type": "string",
          "description": "Accessible relative or absolute URL to the asset"
        },
        "alt": {
          "type": "string",
          "description": "Accessible description or caption"
        },
        "relevance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Relevance score between 0 and 1"
        },
        "license": {
          "type": "string",
          "default": "educational-fair-use",
          "description": "License or provenance label"
        }
      }
    },
    "SlideElement": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Element DOM/Timeline identifier targetable by animations"
        },
        "type": {
          "type": "string"
        },
        "content": {
          "description": "Element textual or structured payload"
        },
        "style": {
          "type": "object",
          "description": "Optional inline CSS overrides or variant styling classes"
        }
      }
    },
    "AnimationItem": {
      "type": "object",
      "required": ["target", "preset", "delay", "duration"],
      "properties": {
        "target": {
          "type": "string",
          "description": "CSS selector or element ID (e.g. #card-1, .bullet-item)"
        },
        "preset": {
          "type": "string",
          "enum": [
            "fade-in",
            "slide-in",
            "zoom-in",
            "typewriter",
            "step-by-step",
            "highlight-keyword"
          ],
          "description": "Predefined GSAP animation preset"
        },
        "delay": {
          "type": "number",
          "minimum": 0.0,
          "description": "Relative delay in seconds from slide start"
        },
        "duration": {
          "type": "number",
          "minimum": 0.1,
          "description": "Animation duration in seconds"
        },
        "easing": {
          "type": "string",
          "default": "power2.out",
          "description": "GSAP easing formula (e.g. power2.out, back.out, none)"
        }
      }
    },
    "VoiceConfig": {
      "type": "object",
      "required": ["narration", "provider"],
      "properties": {
        "narration": {
          "type": "string",
          "description": "Spoken Vietnamese text for this slide"
        },
        "provider": {
          "type": "string",
          "enum": ["vieneu", "viettel", "fake"],
          "description": "TTS Provider engine"
        },
        "voiceId": {
          "type": "string",
          "description": "Speaker voice name (e.g. MyDuyen, HaMy, BanMai)"
        },
        "audioUrl": {
          "type": ["string", "null"],
          "description": "Path or URL to generated WAV/MP3 file (nullable until synthesis)"
        },
        "durationSeconds": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "description": "Measured duration of synthesized audio (nullable until synthesis)"
        }
      }
    }
  }
}
