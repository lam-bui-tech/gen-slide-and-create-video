{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonOutline",
  "description": "Pedagogical outline generated by LLM and approved by teacher before slide generation",
  "type": "object",
  "required": [
    "topic",
    "targetAudience",
    "estimatedDurationMinutes",
    "learningObjectives",
    "slides",
    "summary"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "description": "Main lecture topic or title"
    },
    "targetAudience": {
      "type": "string",
      "description": "Target learner profile (e.g. Sinh viên đại học năm 1, Học sinh THPT)"
    },
    "estimatedDurationMinutes": {
      "type": "number",
      "description": "Estimated total lecture presentation duration in minutes"
    },
    "learningObjectives": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Pedagogical learning objectives (Chuẩn đầu ra bài học)"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sectionTitle", "slideCount"],
        "properties": {
          "sectionTitle": { "type": "string" },
          "description": { "type": "string" },
          "slideCount": { "type": "integer" }
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OutlineSlide"
      },
      "minItems": 1,
      "description": "Planned slides with recommended template and structured draft content"
    },
    "quiz": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/QuizQuestion"
      },
      "description": "Formative assessment check-in questions"
    },
    "summary": {
      "type": "string",
      "description": "Final synthesis and key takeaways of the whole lecture"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved"],
      "default": "draft",
      "description": "Teacher approval status"
    }
  },
  "definitions": {
    "OutlineSlide": {
      "type": "object",
      "required": ["slideId", "suggestedTemplateId", "title", "keyTakeaways", "speakerNotesDraft"],
      "properties": {
        "slideId": {
          "type": "string",
          "description": "Stable unique ID for the slide (e.g. slide-01)"
        },
        "suggestedTemplateId": {
          "type": "string",
          "enum": [
            "title-slide",
            "learning-objectives",
            "concept-explain",
            "bullet-breakdown",
            "image-explain",
            "comparison",
            "timeline",
            "formula-explain",
            "quiz",
            "summary"
          ],
          "description": "One of 10 standard academic pedagogical templates"
        },
        "title": {
          "type": "string",
          "description": "Slide title"
        },
        "keyTakeaways": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Core bullets or concepts to display"
        },
        "speakerNotesDraft": {
          "type": "string",
          "description": "Draft Vietnamese spoken lecture narration for TTS"
        },
        "contentPayload": {
          "type": "object",
          "description": "Template-specific fields (e.g. comparison columns, timeline steps, formula parts)"
        }
      }
    },
    "QuizQuestion": {
      "type": "object",
      "required": ["question", "options", "correctIndex", "explanation"],
      "properties": {
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "correctIndex": { "type": "integer" },
        "explanation": { "type": "string" }
      }
    }
  }
}
